{
  "name": "@secondfactor/js",
  "version": "0.1.1",
  "description": "secondfactor.ai for browsers and React Native: headless phone verification against a session your server created. No dependencies.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/secondfactor/secondfactor-js.git"
  },
  "bugs": {
    "url": "https://github.com/secondfactor/secondfactor-js/issues"
  },
  "homepage": "https://secondfactor.ai",
  "keywords": [
    "otp",
    "2fa",
    "phone-verification",
    "sms",
    "whatsapp",
    "react",
    "react-native",
    "secondfactor"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsdown": "0.23.0",
    "typescript": "7.0.2"
  }
}
